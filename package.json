{
  "name": "berean",
  "version": "0.3.2",
  "description": "Desktop Bible study application for Yehovah's servants",
  "main": "out/main/index.js",
  "author": "Michael Kougang",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:local": "npm run build && electron-builder --mac --publish never",
    "build:draft": "npm run build && electron-builder --mac --publish always",
    "build:mas": "npm run build && electron-builder --mac --config.mac.target=mas --config.mac.hardenedRuntime=false --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:win:publish": "npm run build && electron-builder --win --publish always",
    "build:mac:x64": "npm run build && electron-builder --mac --config.mac.target.arch=x64 --publish never",
    "tag:stable": "node scripts/tag-release.js stable",
    "tag:beta": "node scripts/tag-release.js beta",
    "convert-dbs": "node scripts/convert-dbs.js",
    "data:publish": "node scripts/publish-data.js"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.3",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.15",
    "better-sqlite3": "^12.10.0",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.2.1",
    "marked": "^18.0.4",
    "pdfjs-dist": "^4.10.38",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-markdown": "^6.2.4",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.3",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^3.6.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "eslint": "^9.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.376.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-mosaic-component": "^6.2.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.5.3"
  },
  "build": {
    "appId": "com.berean.app",
    "productName": "Berean",
    "afterPack": "build/afterPack.js",
    "afterSign": "build/notarize.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "**/*.db"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "*.icns",
          "*.ico",
          "*.png"
        ]
      }
    ],
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.reference",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "mas": {
      "target": [
        {
          "target": "mas",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.reference",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "LSMinimumSystemVersion": "12.0"
      },
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "dmg": {
      "title": "Berean ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "RoyalWeden",
      "repo": "Berean",
      "releaseType": "draft"
    }
  }
}
