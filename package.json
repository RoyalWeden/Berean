{
  "name": "berean",
  "version": "0.6.20",
  "description": "Desktop Bible study application for Yehovah's servants",
  "main": "out/main/index.js",
  "author": "Michael Kougang",
  "private": true,
  "scripts": {
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:local": "npm run build && electron-builder --mac --publish never",
    "build:draft": "npm run build && electron-builder --mac --publish always",
    "build:mas": "npm run build && node scripts/mac/build-native.mjs && electron-builder --mac --config.mac.target=mas --config.mac.hardenedRuntime=false --publish never && node scripts/mac/verify-mas.mjs",
    "build:mas:pkg": "node scripts/mac/package-mas.mjs",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:win:publish": "npm run build && electron-builder --win --publish always",
    "build:mac:x64": "npm run build && electron-builder --mac --config.mac.target.arch=x64 --publish never",
    "tag:stable": "node scripts/tag-release.js stable",
    "tag:beta": "node scripts/tag-release.js beta",
    "convert-dbs": "node scripts/convert-dbs.js",
    "transcripts:seed": "node scripts/export-transcript-seed.js",
    "data:publish": "node scripts/publish-data.js",
    "embeddings:build": "node scripts/build-embedding-index.js",
    "ios:build:web": "vite build -c vite.ios.config.ts",
    "ios:sync": "( [ -f data/youtube_index.db ] || node scripts/data/split-youtube-seed.mjs ) && npm run ios:build:web && node scripts/ios/version.mjs && cap sync ios && node scripts/ios/patch-xcodeproj.mjs",
    "ios:open": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer cap open ios",
    "ios:build": "bash scripts/ios/build.sh simulator",
    "ios:device": "bash scripts/ios/build.sh device",
    "ios:archive": "npm run ios:sync && bash scripts/ios/build.sh archive",
    "ios:run": "bash scripts/ios/run.sh",
    "ios:dev": "vite -c vite.ios.config.ts",
    "ios:test": "bash scripts/ios/test.sh",
    "ios:bump-build": "node scripts/ios/version.mjs --bump-build",
    "audit:prod": "node scripts/audit-production.mjs"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-virtual": "^3.14.2",
    "better-sqlite3": "^12.10.0",
    "diff": "^9.0.0",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.2.1",
    "framer-motion": "^12.42.2",
    "kokoro-js": "^1.2.1",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.4",
    "pdfjs-dist": "^4.10.38",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.10",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.0",
    "suncalc": "^2.0.1",
    "zustand": "^4.5.2"
  },
  "overrides": {
    "@radix-ui/react-slot": "^1.2.5"
  },
  "devDependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^3.6.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@types/better-sqlite3": "^7.6.8",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "eslint": "^9.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.376.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-mosaic-component": "^6.2.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.5.3"
  },
  "build": {
    "appId": "com.berean.app",
    "productName": "Berean",
    "afterPack": "build/afterPack.js",
    "afterSign": "build/notarize.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/renderer/assets/ort-wasm-*.wasm"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "*.db",
          "!youtube_index.db"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "*.icns",
          "*.ico",
          "*.png"
        ]
      }
    ],
    "npmRebuild": true,
    "protocols": [
      {
        "name": "Berean deep link",
        "schemes": [
          "berean",
          "berean-pdf"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.reference",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "Berean uses your location only to compute local sunrise time, which determines when a new daily note begins."
      }
    },
    "mas": {
      "target": [
        {
          "target": "mas",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.reference",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "LSMinimumSystemVersion": "12.0",
        "NSLocationWhenInUseUsageDescription": "Berean uses your location only to compute local sunrise time, which determines when a new daily note begins."
      },
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extraResources": [
        {
          "from": "build/native",
          "to": "native",
          "filter": [
            "berean_icloud.node"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Berean ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "RoyalWeden",
      "repo": "Berean",
      "releaseType": "draft"
    }
  }
}
