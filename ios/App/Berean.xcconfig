// Shared build settings for the Berean iOS app (both configurations).
// Committed defaults; the developer's signing settings live in Signing.xcconfig (gitignored).
#include "Version.xcconfig"

BEREAN_TEAM_ID =
CODE_SIGN_ENTITLEMENTS = App/App.entitlements
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Developer-specific signing (team id, signing style). Optional include: the project builds for
// the simulator without it; a device/TestFlight build needs it.
#include? "Signing.xcconfig"

// App identity — Berean or Berean Dev (config/app-identity.json): bundle ID, display name, iCloud
// container, App Group, URL schemes. Generated by `npm run ios:sync` (scripts/ios/identity.mjs,
// BEREAN_IDENTITY=production|development). Included LAST and required: identity values come only
// from here, never from Signing.xcconfig, and a missing file fails the build instead of guessing.
#include "Identity.xcconfig"
