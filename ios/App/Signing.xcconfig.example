// Copy to Signing.xcconfig (gitignored) and fill in — see docs/mobile/ios-build.md §2.
// Signing only. The app identity (bundle ID, iCloud container, App Group) comes from
// Identity.xcconfig, generated by `npm run ios:sync` from config/app-identity.json, and wins over
// anything set here.
DEVELOPMENT_TEAM = ABCDE12345
BEREAN_TEAM_ID = ABCDE12345
CODE_SIGN_STYLE = Automatic
